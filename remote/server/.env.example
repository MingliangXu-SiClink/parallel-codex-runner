PCR_RELAY_ENV=production
PCR_RELAY_DATABASE_URL=postgresql+asyncpg://pcr_relay:change-me@127.0.0.1/pcr_relay
PCR_RELAY_PUBLIC_BASE_URL=https://pcr.example.com
PCR_RELAY_JWT_SECRET=generate-at-least-32-random-characters
PCR_RELAY_MAC_ENROLLMENT_TOKEN=generate-another-independent-random-token
PCR_WECHAT_APP_ID=
PCR_WECHAT_APP_SECRET=
PCR_RELAY_ALLOWED_WECHAT_SUBJECTS=
PCR_RELAY_AUTO_APPROVE_WECHAT=false
PCR_RELAY_OFFLINE_ENVELOPE_SECONDS=86400
PCR_RELAY_MAX_CIPHERTEXT_BYTES=2097152
PCR_RELAY_MAX_PENDING_ENVELOPES_PER_DEVICE=512
PCR_RELAY_MAX_PENDING_BYTES_PER_DEVICE=134217728
PCR_RELAY_CLEANUP_INTERVAL_SECONDS=3600

# Optional private Android update channel. Keep this directory outside every
# web root and grant it only to the relay service account.
PCR_RELAY_ANDROID_UPDATE_DIR=/var/lib/pcr-relay/android-releases
PCR_RELAY_ANDROID_UPDATE_TICKET_SECONDS=300
PCR_RELAY_ANDROID_RELEASE_RETENTION=20
PCR_RELAY_ANDROID_UPDATE_MAX_BYTES=536870912
PCR_RELAY_ANDROID_PACKAGE_NAME=com.parallelcodexrunner.remote
PCR_RELAY_ANDROID_SIGNING_CERTIFICATE_SHA256=

# Optional private macOS update channel. Keep this directory outside every web
# root and grant it only to the relay service account.
PCR_RELAY_MACOS_UPDATE_DIR=/var/lib/pcr-relay/macos-releases
PCR_RELAY_MACOS_UPDATE_TICKET_SECONDS=300
PCR_RELAY_MACOS_RELEASE_RETENTION=20
PCR_RELAY_MACOS_UPDATE_MAX_BYTES=536870912
PCR_RELAY_MACOS_BUNDLE_ID=com.parallelcodexrunner.mac

# Product feedback inbox. Feedback never includes prompts, conversations, or
# project files unless a future client asks for separate explicit consent.
PCR_RELAY_FEEDBACK_MAX_ATTACHMENT_BYTES=1048576
PCR_RELAY_FEEDBACK_MAX_TOTAL_ATTACHMENT_BYTES=4194304
PCR_RELAY_FEEDBACK_MAX_ATTACHMENTS=4
PCR_RELAY_FEEDBACK_SUBMISSIONS_PER_HOUR=20
PCR_RELAY_FEEDBACK_MAX_ACTIVE_PER_USER=500
