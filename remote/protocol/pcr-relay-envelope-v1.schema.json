{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parallel-codex-runner.local/protocol/pcr-relay-envelope-v1.schema.json",
  "title": "PCR opaque relay envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message_id",
    "target_device_id",
    "sequence",
    "ciphertext"
  ],
  "properties": {
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "target_device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "ciphertext": {
      "type": "string",
      "minLength": 1
    }
  }
}
